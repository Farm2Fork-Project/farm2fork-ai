# Production serving configuration. Supply credentials through the environment.
APP_ENV=production
AI_SERVICE_TOKEN=
ALLOW_UNTRAINED_MODEL=false
MODEL_CHECKPOINT=/app/models/best_model.pth
MODEL_CONFIG=/app/configs/grade_only_four_crops_dedup_15ep.yaml
MODEL_PHOTO_REFERENCE=/app/reference/photo_reference.npz
MODEL_TRAINED_CROPS=wheat,rice,mango,maize
OFFICIAL_PRICES=/app/configs/official_prices.json
MAX_IMAGE_BYTES=8388608
